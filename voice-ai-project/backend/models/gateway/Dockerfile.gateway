# backend/models/gateway/Dockerfile.gateway
FROM python:3.11-slim

# lib & build tools (บางสภาพแวดล้อม wheel webrtcvad มีอยู่แล้ว แต่ลงไว้กันเหนียว)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3-dev curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# แยกเลเยอร์ requirements เพื่อ cache ดี ๆ
COPY requirements.txt /app/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r /app/requirements.txt

# ค่อย copy โค้ด
COPY . /app

# รัน
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8010"]
